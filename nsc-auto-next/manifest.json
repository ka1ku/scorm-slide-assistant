{
  "manifest_version": 3,
  "name": "SCORM Slide Assistant",
  "version": "1.2.0",
  "description": "Optional slide navigation and playback-speed controls for Articulate Storyline SCORM courses in your browser.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SCORM Slide Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://training.nsc.org/*",
        "https://*.nsc.org/*",
        "https://*.scormcloud.com/*",
        "https://*.cloud.scorm.com/*",
        "https://scorm.thoughtindustries.com/*",
        "https://*.thoughtindustries.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["focus-patch.js"]
    },
    {
      "matches": [
        "https://training.nsc.org/*",
        "https://*.nsc.org/*",
        "https://*.scormcloud.com/*",
        "https://*.cloud.scorm.com/*",
        "https://scorm.thoughtindustries.com/*",
        "https://*.thoughtindustries.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
